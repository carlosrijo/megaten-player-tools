bin/
obj/
*.user
.vs/

# demon icons for the DCM Locator: the game's own art, made locally by tools\dcmexport
app/ui/dcm-icons/
# enemy pictures for the Dungeon Database: game art, made locally by imagine-reader dungeons --client
app/ui/dungeon-icons/
# the assistant's 3D model: the game's own art, made locally from the client (imagine-reader.exe model, or the app on first use)
data/cache/models/
data/characters/*/cache/models/
# demon and skill pictures for the Demon Database: the game's own art, made locally by imagine-reader demondb
app/ui/demon-db-icons/
# skill pictures for the Skill Database: the game's own art, made locally by imagine-reader skilldb
app/ui/skill-db-icons/
# item pictures for the Item Database: the game's own art, made locally by imagine-reader geardb --client
app/ui/gear-db-icons/
# your own data (stats, gear, characters, pictures, paths on this PC): kept on disk, never committed
/data/
# the portable release, made by tools\publish-portable.ps1
dist/
/demo/

# Rust build output
/target/
# the release exe's debug symbols (BABEL.pdb): not shipped, kept as a workflow artifact for reading crash reports
dist-symbols/

# our own notes and agent setup (local paths, how we work): kept on disk, never committed
/.claude/
/CLAUDE.md
/HANDOVER.md
/PORTING.md
/reference/README.md
/bug-report-*.md
/legacy-powershell/
# the C# version the Rust code was ported from, and its tools and scripts: kept on disk, never committed
/*.csproj
/src/
/app/*.cs
/app/*.csproj
/page/
/tools/*/
/tools/*.ps1
!/tools/publish-portable.ps1
!/tools/rebuild-app.ps1
!/tools/refresh-bundled-data.ps1
!/tools/build-site.ps1
/reference/clientdata-scripts/*.ps1

# private keys: the feedback GitHub App's key stays in .secrets\ (never in git; feedback-worker\set-key.ps1 loads it into Cloudflare)
/.secrets/
*.pem

# Made locally with the sealed data (reference\sealed\README.md); never committed
/app/ui/*.local.json
# the website, made by toolsuild-site.ps1
/site/
# wrangler's local state (pages deploy from the repo folder)
/.wrangler/
